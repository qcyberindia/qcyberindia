# QCyberIndia - environment variables
#
# This file is a template only - every value below is a placeholder.
# Copy it to .env.local and fill in real values for local development:
#   cp .env.example .env.local
#
# Every variable here was found by inspecting actual usage in the codebase
# (lib/db.ts, lib/email.ts, lib/admin-auth.ts, Analytics.tsx, app/layout.tsx,
# app/qbids/page.tsx). Nothing speculative is included.

# -----------------------------------------------------------------------
# Database (Qbids + QFinance registrations, unified /admin counts)
# -----------------------------------------------------------------------
# Required for persistence. Without it, the app does not crash -
# registrations fail gracefully with a clear error, and /admin shows 0
# counts with a "no database configured" warning.
DATABASE_URL=

# Optional. Most managed Postgres providers (Neon, RDS, Supabase) require
# SSL and this can be left unset. Set to "false" only for a local/
# self-hosted Postgres that doesn't support SSL.
DATABASE_SSL=

# -----------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------
# Required to actually send email - used by the contact form and the
# Qbids beta registration notification. Without it, sends fail with a
# clear "RESEND_API_KEY is not configured" error; nothing crashes.
RESEND_API_KEY=

# -----------------------------------------------------------------------
# Admin authentication (unified /admin - covers Qbids and QFinance)
# -----------------------------------------------------------------------
# Required to log into /admin, /admin/qbids, /admin/qfinance. ONE password
# for the entire QCyberIndia admin - there is no separate Qbids or
# QFinance admin password. Choose a strong value; this gates access to
# registration data for both products.
QCYBERINDIA_ADMIN_PASSWORD=

# -----------------------------------------------------------------------
# QFinance Community authentication (magic-link, passwordless)
# -----------------------------------------------------------------------
# Required for QFinance Community sign-in to work at all — without it,
# both the magic-link request and verification endpoints return a clear
# 503 rather than crashing. Deliberately separate from
# QCYBERINDIA_ADMIN_PASSWORD: a community member's session must never be
# interchangeable with an admin session.
QFINANCE_AUTH_SECRET=

# -----------------------------------------------------------------------
# Analytics & tracking (all optional - each feature is skipped entirely
# if its variable is unset, with no placeholder/fallback behavior)
# -----------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GTM_ID=

# Google Search Console - only needed if using the HTML meta-tag
# verification method instead of a DNS TXT record.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------
# Qbids landing page (optional)
# -----------------------------------------------------------------------
# Vimeo/YouTube embed URL for the "prefer a quick tour" demo video section
# on /qbids. Leave blank to hide that section entirely (the screenshot
# showcase above it is unaffected either way).
NEXT_PUBLIC_QBIDS_DEMO_URL=
